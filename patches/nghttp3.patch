+  assert_uint64(latest.glitch_ratelim_burst, ==, srcbuf.glitch_ratelim_burst);
+  assert_uint64(latest.glitch_ratelim_rate, ==, srcbuf.glitch_ratelim_rate);
+
+  srcbuf.qpack_indexing_strat = NGHTTP3_QPACK_INDEXING_STRAT_EAGER;
+
+  src = malloc(v4len);
+  memcpy(src, &srcbuf, v4len);
+
+  dest =
+    nghttp3_settings_convert_to_latest(&settingsbuf, NGHTTP3_SETTINGS_V4, src);
+
+  free(src);
+
+  assert_ptr_equal(&settingsbuf, dest);
+  assert_uint64(NGHTTP3_QPACK_INDEXING_STRAT_EAGER, ==,
+                dest->qpack_indexing_strat);
+  assert_int(0, ==, dest->grease_frame);
+
+  settingsbuf.grease_frame = 1;
+  src = malloc(v4len);
+  nghttp3_settings_convert_to_old(NGHTTP3_SETTINGS_V4, src, &settingsbuf);
+
+  assert_uint64(NGHTTP3_QPACK_INDEXING_STRAT_EAGER, ==,
+                src->qpack_indexing_strat);
+
+  free(src);
 }
 
