+int nghttp3_stream_write_grease(nghttp3_stream *stream,
+                                const nghttp3_frame_grease *fr) {
+  nghttp3_buf *chunk;
+  nghttp3_typed_buf tbuf;
+  int64_t payloadlen = (int64_t)fr->payloadlen;
+  int rv;
+
+  assert(fr->payloadlen <= sizeof(fr->payload));
+
+  rv = nghttp3_stream_ensure_chunk(
+    stream,
+    nghttp3_frame_write_hd_len(fr->grease_type, payloadlen) + fr->payloadlen);
+  if (rv != 0) {
+    return rv;
+  }
+
+  chunk = nghttp3_stream_get_chunk(stream);
+  nghttp3_typed_buf_shared_init(&tbuf, chunk);
+
+  chunk->last = nghttp3_frame_write_hd(chunk->last, fr->grease_type, payloadlen);
+  chunk->last = nghttp3_cpymem(chunk->last, fr->payload, fr->payloadlen);
+
+  tbuf.buf.last = chunk->last;
+
+  return nghttp3_stream_outq_add(stream, &tbuf);
+}
