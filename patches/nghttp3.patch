+/*
+ * conn_grease_rand fills |dest| of length |destlen| with random bytes
+ * from the rand callback.  Without the callback, it falls back to
+ * splitmix64 seeded by heap and stack addresses, which only varies as
+ * much as ASLR does.
+ */
+static void conn_grease_rand(nghttp3_conn *conn, uint8_t *dest,
+                             size_t destlen) {
+  uint64_t x, z;
