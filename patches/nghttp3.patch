+  rv = nghttp3_conn_bind_control_stream(conn, 3);
+
+  assert_int(0, ==, rv);
+
+  sveccnt = nghttp3_conn_writev_stream(conn, &stream_id, &fin, vec,
+                                       nghttp3_arraylen(vec));
+
+  assert_int64(3, ==, stream_id);
+  assert_ptrdiff(1, ==, sveccnt);
+  assert_size(1, <, vec[0].len);
+  assert_uint8(NGHTTP3_STREAM_TYPE_CONTROL, ==, vec[0].base[0]);
+
+  ++vec[0].base;
+  --vec[0].len;
+
+  fr.settings.iv = sent_ents;
+  nread = nghttp3_decode_settings_frame(&fr.settings, vec, 1);
+
+  assert_ptrdiff((nghttp3_ssize)vec[0].len, ==, nread);
+  assert_size(nghttp3_arraylen(ents), ==, fr.settings.niv);
+
+  assert_uint64(ents[0].id, ==, fr.settings.iv[0].id);
+  assert_uint64(ents[0].value, ==, fr.settings.iv[0].value);
+  assert_uint64(ents[1].id, ==, fr.settings.iv[1].id);
+  assert_uint64(ents[1].value, ==, fr.settings.iv[1].value);
+  assert_uint64(ents[2].id, ==, fr.settings.iv[2].id);
+  assert_uint64(ents[2].value, ==, fr.settings.iv[2].value);
+  assert_uint64(ents[3].id, ==, fr.settings.iv[3].id);
+  assert_uint64(ents[3].value, ==, fr.settings.iv[3].value);
+
+  rv = nghttp3_conn_submit_settings(conn, 0, ents, nghttp3_arraylen(ents));
+
+  assert_int(NGHTTP3_ERR_INVALID_STATE, ==, rv);
+
+  nghttp3_conn_del(conn);
+}
+
+static uint8_t grease_rand_next;
+
+static void grease_rand(uint8_t *dest, size_t destlen) {
+  for (; destlen; --destlen) {
+    *dest++ = ++grease_rand_next;
+  }
+}
+
+/* write_grease_control writes the control stream of a client created
+   with |settings| and |callbacks|, checks that a SETTINGS frame
+   follows the stream type, and returns the bytes after the SETTINGS
+   frame in |*prest|. */
+static void write_grease_control(nghttp3_vec *prest,
+                                 const nghttp3_callbacks *callbacks,
+                                 const nghttp3_settings *settings,
+                                 nghttp3_conn **pconn) {
+  nghttp3_vec vec[256];
+  nghttp3_ssize sveccnt, hdlen;
+  nghttp3_raw_frame_hd hd;
+  int64_t stream_id;
+  int fin;
+  int rv;
+
+  rv = nghttp3_conn_client_new(pconn, callbacks, settings,
+                               nghttp3_mem_default(), NULL);
+
+  assert_int(0, ==, rv);
+
+  rv = nghttp3_conn_bind_control_stream(*pconn, 2);
+
+  assert_int(0, ==, rv);
+
+  sveccnt = nghttp3_conn_writev_stream(*pconn, &stream_id, &fin, vec,
+                                       nghttp3_arraylen(vec));
+
+  assert_int64(2, ==, stream_id);
+  assert_ptrdiff(1, ==, sveccnt);
+  assert_uint8(NGHTTP3_STREAM_TYPE_CONTROL, ==, vec[0].base[0]);
+
+  ++vec[0].base;
+  --vec[0].len;
+
+  hdlen = nghttp3_decode_raw_frame_hd(&hd, vec, 1);
+
+  assert_ptrdiff(0, <, hdlen);
+  assert_int64(NGHTTP3_FRAME_SETTINGS, ==, hd.type);
+  assert_size(vec[0].len, >=, (size_t)hdlen + (size_t)hd.length);
+
+  *prest = (nghttp3_vec){
+    .base = vec[0].base + hdlen + hd.length,
+    .len = vec[0].len - (size_t)hdlen - (size_t)hd.length,
+  };
+}
+
+void test_nghttp3_conn_grease_frame(void) {
+  nghttp3_conn *conn;
+  nghttp3_callbacks callbacks;
+  nghttp3_settings settings;
+  nghttp3_vec rest;
+  nghttp3_ssize hdlen;
+  nghttp3_raw_frame_hd hd;
+  uint64_t n = 0;
+  size_t i;
+
+  memset(&callbacks, 0, sizeof(callbacks));
+  nghttp3_settings_default(&settings);
+
+  /* Disabled by default */
+  assert_int(0, ==, settings.grease_frame);
+
+  write_grease_control(&rest, &callbacks, &settings, &conn);
+
+  assert_size(0, ==, rest.len);
+
+  nghttp3_conn_del(conn);
+
+  /* Enabled: one reserved frame right after SETTINGS, with the type
+     and the payload drawn from the rand callback. */
+  callbacks.rand = grease_rand;
+  settings.grease_frame = 1;
+  grease_rand_next = 0;
+
+  write_grease_control(&rest, &callbacks, &settings, &conn);
+
+  /* The map seed is drawn first. */
+  grease_rand_next = sizeof(uint64_t);
+
+  for (i = 0; i < 8; ++i) {
+    n = (n << 8) | (uint8_t)(grease_rand_next + i + 1);
+  }
+
+  hdlen = nghttp3_decode_raw_frame_hd(&hd, &rest, 1);
+
+  assert_ptrdiff(0, <, hdlen);
+  assert_int64((int64_t)(0x1f * (n % (NGHTTP3_GREASE_FRAME_N_MAX + 1)) + 0x21),
+               ==, hd.type);
+  assert_int64((grease_rand_next + 9) % 8, ==, hd.length);
+  assert_size((size_t)hdlen + (size_t)hd.length, ==, rest.len);
+
+  for (i = 0; i < (size_t)hd.length; ++i) {
+    assert_uint8((uint8_t)(grease_rand_next + 10 + i), ==, rest.base[hdlen + i]);
+  }
+
+  nghttp3_conn_del(conn);
+
+  /* Without the rand callback, a valid reserved frame is still sent. */
+  callbacks.rand = NULL;
+
+  write_grease_control(&rest, &callbacks, &settings, &conn);
+
+  hdlen = nghttp3_decode_raw_frame_hd(&hd, &rest, 1);
+
+  assert_ptrdiff(0, <, hdlen);
+  assert_int64(0, ==, (hd.type - 0x21) % 0x1f);
+  assert_int64(0x21, <=, hd.type);
+  assert_int64(NGHTTP3_GREASE_FRAME_MAX_PAYLOADLEN, >=, hd.length);
+  assert_size((size_t)hdlen + (size_t)hd.length, ==, rest.len);
+
+  nghttp3_conn_del(conn);
+}
