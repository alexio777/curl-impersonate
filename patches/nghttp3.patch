+/* curl-impersonate: NGHTTP3_SETTINGS_V4 ends at qpack_indexing_strat;
+   grease_frame of NGHTTP3_SETTINGS_V5 defaults to 0. */
+void test_nghttp3_settings_convert_v4(void) {
+  nghttp3_settings *src, srcbuf, settingsbuf, latest;
+  const nghttp3_settings *dest;
+  size_t v4len;
+
+  v4len = nghttp3_settingslen_version(NGHTTP3_SETTINGS_V4);
+
+  assert_size(offsetof(nghttp3_settings, qpack_indexing_strat) +
+                sizeof(srcbuf.qpack_indexing_strat),
